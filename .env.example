# ============================================================
# Google Earth Engine (Service Account)
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
SERVICE_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
PROJECT_ID="your-gee-project-id"

# ============================================================
# Google Earth Engine Assets
# ============================================================
REGIONS_FC="projects/your-project/assets/your-regions-asset"
DISTRICTS_FC="projects/your-project/assets/your-districts-asset"

# ============================================================
# Supabase Auth (server-side)
# ============================================================
PUBLISHABLE_KEY="sb_publishable_YOUR_KEY_HERE"
SECRET_KEY="sb_secret_YOUR_KEY_HERE"

# ============================================================
# Supabase Auth (client-side — safe for browser via NEXT_PUBLIC_)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_YOUR_ANON_KEY_HERE"
